# Copier vers .streamlit/secrets.toml (local) ou coller dans Streamlit Cloud > Settings > Secrets.
# NE PAS pousser le vrai fichier secrets.toml sur GitHub.
SUPABASE_URL = "https://xxxx.supabase.co"
SUPABASE_KEY = "clé service_role" # secret serveur uniquement, jamais la clé anon/publishable
GEMINI_API_KEY = ""               # facultatif ; le compte demo n'utilise jamais l'IA
# GEMINI_MODEL = "gemini-3.6-flash" # facultatif

[users.demo]
password = "demo"
demo = true

[users.theo]
password = "REMPLACER_PAR_UN_MOT_DE_PASSE_LONG_ET_UNIQUE"
demo = false

# Ajouter les prochains comptes sur le même modèle :
# [users.alice]
# password = "mot-de-passe-long-et-unique"
# demo = false
