# Copier vers .streamlit/secrets.toml (local ; ce fichier est ignoré par Git) ou coller dans
# Streamlit Community Cloud > Settings > Secrets. NE JAMAIS pousser le vrai fichier sur GitHub.
SUPABASE_URL = "https://xxxx.supabase.co"
SUPABASE_KEY = "clé service_role" # secret serveur uniquement, jamais la clé anon/publishable
GEMINI_API_KEY = ""               # facultatif ; le compte demo n'utilise jamais l'IA
# GEMINI_MODEL = "gemini-3.6-flash" # facultatif
# AUTO_CONNEXION_DEMO = false       # facultatif : true = l'app s'ouvre sur le compte demo (lecture seule en base)
# DEBUG_PERF = true                 # facultatif : affiche les temps de chaque étape
# QUOTA_IA_GLOBAL_PAR_JOUR = 300    # facultatif : plafond d'appels Gemini par jour, tous comptes confondus

# Comptes : un bloc [users.identifiant] par utilisateur, mot de passe en clair (les secrets ne sont jamais dans le dépôt).
[users.demo]
password = "demo"          # compte public par conception : lecture seule en base, modifications gardées en session
demo = true

[users.theo]
password = "REMPLACER"
demo = false

# Ajouter les prochains comptes sur le même modèle :
# [users.alice]
# password = "…"
# demo = false
